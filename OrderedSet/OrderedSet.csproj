<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The assembly, not the namespace: `OrderedSet.OrderedSet<T>` is
             unaffected. Assembly names are matched without regard to case, so
             this and the `(std orderedset)` module's own `orderedset.dll` would
             otherwise be one name to the loader. -->
        <AssemblyName>BjoOrderedSet</AssemblyName>
    </PropertyGroup>

</Project>
